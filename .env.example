# Copy this file to .env for local development:  cp .env.example .env
# On Render, set the same names under your service's Environment tab.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Add your domain when you have one, e.g. https://projectaethrix.com
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# --- Database ---
# Not needed on your computer: the website uses the db.sqlite3 file.
# On Render this is filled in automatically from the PostgreSQL database.
# DATABASE_URL=

# --- Founder login ---
# Your founder account. Run `python manage.py ensure_founder` once locally;
# on Render, build.sh creates it automatically on the first deploy.
FOUNDER_EMAIL=projectaethrix@gmail.com
FOUNDER_PASSWORD=
# Secret addresses (never shown on the website). Change all three to something
# hard to guess on the live site, e.g.
#   FOUNDER_URL=aethrix-hq-7392/        founder dashboard (only you)
#   ADMIN_PANEL_URL=aethrix-team-5180/  admin dashboard (your admins + you)
#   ADMIN_URL=aethrix-backup-4810/      Django backup admin (only you)
FOUNDER_URL=founder/
ADMIN_PANEL_URL=admin-panel/
ADMIN_URL=admin/

# --- Email ---
CONTACT_EMAIL=projectaethrix@gmail.com
BOOKING_NOTIFY_EMAIL=projectaethrix@gmail.com
DEFAULT_FROM_EMAIL=Project Aethrix <projectaethrix@gmail.com>
# Option A (recommended on Render's free plan): Brevo email API key
BREVO_API_KEY=
# Option B (paid hosting only): Gmail SMTP with an App Password
# EMAIL_PROVIDER=smtp
# EMAIL_HOST_USER=projectaethrix@gmail.com
# EMAIL_HOST_PASSWORD=your-16-letter-app-password
# With neither set, emails are printed in the terminal instead of sent.

# --- Founder ---
FOUNDER_PORTFOLIO_URL=https://jonayed-portfolio.onrender.com